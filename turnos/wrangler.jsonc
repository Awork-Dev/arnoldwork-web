// Worker que sirve TurnoWork (turnos.arnoldwork.com): cuadrante de turnos para todo el año, con Pro por Ko-fi.
// /api/* y /cal/* (sincronización y calendario suscrito de Pro) los atiende el Worker «vigilante».
{
  "name": "turnos",
  "account_id": "53cbf9156847de65986cbfdb2ea9e4b5",
  "compatibility_date": "2026-10-05",
  "main": "worker.js",
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": ["/api/*", "/cal/*"] },
  "services": [{ "binding": "VIGILANTE", "service": "vigilante" }],
  "routes": [{ "pattern": "turnos.arnoldwork.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true
}
